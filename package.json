{
  "name": "mp-inspector",
  "version": "1.0.0",
  "private": true,
  "description": "A debugging panel for WeChat Mini Programs with zero runtime dependencies.",
  "main": "src/core/index.js",
  "scripts": {
    "build": "node scripts/build.js",
    "build:full": "node scripts/build.js full",
    "build:lite": "node scripts/build.js lite",
    "demo:sync": "node scripts/sync-demo.js",
    "test": "node --test tests/*.test.js",
    "check": "npm run build && npm test && npm run demo:sync",
    "package": "npm run check && node scripts/package.js"
  },
  "keywords": [
    "miniprogram",
    "wechat",
    "debug",
    "console",
    "vconsole",
    "devtools",
    "network"
  ],
  "author": "captainamari",
  "repository": { "type": "git", "url": "https://github.com/captainamari/mp-inspector.git" },
  "bugs": { "url": "https://github.com/captainamari/mp-inspector/issues" },
  "engines": { "node": ">=22" },
  "license": "MIT",
  "devDependencies": {
    "clean-css": "5.3.3",
    "terser": "5.46.1"
  }
}
